# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Public URL of this API. Only needed in production to decide the cookie's
# SameSite attribute. Optional: COOKIE_SAMESITE=lax|none|strict overrides it.
API_URL=
# COOKIE_SAMESITE=

# --- Database ---
MONGO_URI=mongodb://localhost:27017/murmur

# --- Auth ---
# At least 32 random characters. Example generator:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=abe342bcb4a3083b7a2e1455ec0b667a04bdb59c4061c7e3ac0bd5f9972530dd3d04e0bfab29cbc5b2976545b6dcb259
JWT_EXPIRES_IN=7d

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
