# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=5000
# The web app's origin. It is the only allowed CORS origin, the Socket.IO
# origin, and the Clerk session token's authorized party.
CLIENT_URL=http://localhost:3000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/murmur

# --- Clerk (authentication) ---
# From https://dashboard.clerk.com -> API keys. CLERK_SECRET_KEY is server-only:
# never expose it to the browser or to a NEXT_PUBLIC_* variable.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional but recommended: the PEM public key from the API keys page. With it,
# session tokens are verified locally instead of against Clerk's JWKS endpoint.
# In .env, keep the whole PEM in double quotes; real line breaks are fine.
CLERK_JWT_KEY=
# Comma-separated extra origins whose tokens should be accepted, for example a
# Vercel preview deployment. CLIENT_URL is always included.
# CLERK_AUTHORIZED_PARTIES=https://murmur.vercel.app

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
